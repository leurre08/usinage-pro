import 'package:flutter/material.dart';
import 'operation_screen.dart';

class MaterialScreen extends StatelessWidget {
  final String brandId;
  const MaterialScreen({super.key, required this.brandId});

  final List<Map<String, String>> materials = const [
    {'id': 'p1', 'name': 'Acier non allié (P1)'},
    {'id': 'p2', 'name': 'Acier basse légé (P2)'},
    {'id': 'p3', 'name': 'Acier inoxydable (M1)'},
    {'id': 'p4', 'name': 'Fonte (K1)'},
    {'id': 'p5', 'name': 'Aluminium (N1)'},
    {'id': 'p6', 'name': 'Titane (S1)'},
    {'id': 'p7', 'name': 'Acier trempé (H1)'},
  ];

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text('3/4 - Matière usinée'), centerTitle: true),
      body: ListView.builder(
        itemCount: materials.length,
        itemBuilder: (context, index) {
          final mat = materials[index];
          return ListTile(
            leading: const Icon(Icons.category, color: Colors.blueGrey),
            title: Text(mat['name']!),
            trailing: const Icon(Icons.chevron_right),
            onTap: () {
              Navigator.push(
                context,
                MaterialPageRoute(
                  builder: (_) => OperationScreen(
                    brandId: brandId,
                    materialId: mat['id']!,
                    materialName: mat['name']!,
                  ),
                ),
              );
            },
          );
        },
      ),
    );
  }
}
